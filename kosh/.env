# ---- API configuration (Vite only exposes variables that start with VITE_) ----
# PHP API address (backend/ folder). XAMPP: http://localhost/kosh/backend
VITE_API_BASE_URL=http://localhost/kosh/backend

# true  = use the built-in mock API (no backend needed, works exactly like the old demo)
# false = call the real PHP API at VITE_API_BASE_URL
VITE_USE_MOCK=false

# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# Authorization header prefix. "Bearer" for SimpleJWT, "Token" for DRF TokenAuthentication.
VITE_AUTH_SCHEME=Bearer

# Fake network delay (ms) for the mock API. Set 0 to make it instant.
VITE_MOCK_DELAY_MS=250
